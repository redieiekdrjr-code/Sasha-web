{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igrogram",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "../public/igrogram",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_HUB", "class_name": "ChatHub" }
    ]
  },
  "exports": {
    "ChatHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
